{
  "name": "findmy-cli",
  "version": "0.3.2",
  "description": "OpenClaw plugin for macOS Find My friend locations. Read-only and consent-bounded: it reads only the friends who have already opted in to share with this Mac's Apple ID and returns coarse location only. Shells out to the findmy CLI, which reads FindMy.app through macOS Accessibility. macOS-only; requires Accessibility permission.",
  "type": "module",
  "openclaw": {
    "extensions": [
      "./src/index.ts"
    ],
    "compat": {
      "pluginApi": ">=2026.6.5"
    },
    "build": {
      "openclawVersion": "2026.6.5",
      "pluginSdkVersion": "2026.6.5"
    },
    "environment": {
      "binaries": [
        "findmy",
        "findmy-helper"
      ],
      "osPermissions": [
        "macos:accessibility"
      ]
    },
    "hostTargets": [
      "darwin-arm64",
      "darwin-x64"
    ]
  },
  "files": [
    "dist/",
    "src/",
    "skills/",
    "openclaw.plugin.json"
  ],
  "main": "./dist/index.js",
  "keywords": [
    "openclaw",
    "openclaw-plugin",
    "findmy",
    "location",
    "macos",
    "accessibility",
    "ax"
  ],
  "author": {
    "name": "Omar Shahine",
    "email": "omar@shahine.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/LPFchan/findmy-cli.git",
    "directory": "openclaw"
  },
  "homepage": "https://github.com/LPFchan/findmy-cli#readme",
  "bugs": {
    "url": "https://github.com/LPFchan/findmy-cli/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "os": [
    "darwin"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@sinclair/typebox": "^0.34.49",
    "openclaw": "^2026.6.5"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --out-dir dist --clean --target node20",
    "plugin:check": "npx --yes @openclaw/plugin-inspector inspect --no-openclaw",
    "plugin:ci": "npx --yes @openclaw/plugin-inspector ci --no-openclaw --runtime --mock-sdk --allow-execute",
    "prepack": "npm run build"
  }
}
